# SPDX-License-Identifier: MIT

if BOARD_PLANCK_LEFT

config ZMK_KEYBOARD_NAME
    default "Planck Split"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_PLANCK_LEFT

if BOARD_PLANCK_LEFT || BOARD_PLANCK_RIGHT

# This keyboard's halves communicate over BLE and persist their bonds in NVS.
config ZMK_BLE
    default y

config ZMK_SPLIT
    default y

config SETTINGS
    default y

config NVS
    default y

config SETTINGS_NVS
    default y

config FLASH_MAP
    default y

config BT_SETTINGS
    default y

if USB_DEVICE_STACK
config USB_NRFX
    default y
endif # USB_DEVICE_STACK

config BT_CTLR
    default BT

endif # BOARD_PLANCK_LEFT || BOARD_PLANCK_RIGHT
