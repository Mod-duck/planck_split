#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <physical_layouts.dtsi>
#include "leds.dtsi"
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

/ {
    model = "planck";
    compatible = "yangxing,planck";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,settings-partition = &storage_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,entropy = &rng;
        zmk,battery = &vbatt;
        zmk,kscan = &kscan;
        zmk,physical-layout = &matrix_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <48>;
        rows = <1>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)   RC(0,24) RC(0,25) RC(0,26) RC(0,27) RC(0,28) RC(0,29)
            RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)  RC(0,30) RC(0,31) RC(0,32) RC(0,33) RC(0,34) RC(0,35)
            RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)  RC(0,36) RC(0,37) RC(0,38) RC(0,39) RC(0,40) RC(0,41)
            RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23)  RC(0,42) RC(0,43) RC(0,44) RC(0,45) RC(0,46) RC(0,47)
        >;
    };

    matrix_physical_layout: matrix_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "PLANCKEYS default";
        
        transform = <&default_transform>;
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500    0       0     0     0>
            , <&key_physical_attrs 100 100  800    0       0  1400     0>
            , <&key_physical_attrs 100 100  900    0       0  1400     0>
            , <&key_physical_attrs 100 100 1000    0       0  1400     0>
            , <&key_physical_attrs 100 100 1100    0       0  1400     0>
            , <&key_physical_attrs 100 100 1200    0       0  1400     0>
            , <&key_physical_attrs 100 100 1300    0       0  1400     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  500  100       0     0     0>
            , <&key_physical_attrs 100 100  800  100       0  1400     0>
            , <&key_physical_attrs 100 100  900  100       0  1400     0>
            , <&key_physical_attrs 100 100 1000  100       0  1400     0>
            , <&key_physical_attrs 100 100 1100  100       0  1400     0>
            , <&key_physical_attrs 100 100 1200  100       0  1400     0>
            , <&key_physical_attrs 100 100 1300  100       0  1400     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  200       0     0     0>
            , <&key_physical_attrs 100 100  800  200       0  1400     0>
            , <&key_physical_attrs 100 100  900  200       0  1400     0>
            , <&key_physical_attrs 100 100 1000  200       0  1400     0>
            , <&key_physical_attrs 100 100 1100  200       0  1400     0>
            , <&key_physical_attrs 100 100 1200  200       0  1400     0>
            , <&key_physical_attrs 100 100 1300  200       0  1400     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100  100  300       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  300       0     0     0>
            , <&key_physical_attrs 100 100  500  300       0     0     0>
            , <&key_physical_attrs 100 100  800  300       0  1400     0>
            , <&key_physical_attrs 100 100  900  300       0  1400     0>
            , <&key_physical_attrs 100 100 1000  300       0  1400     0>
            , <&key_physical_attrs 100 100 1100  300       0  1400     0>
            , <&key_physical_attrs 100 100 1200  300       0  1400     0>
            , <&key_physical_attrs 100 100 1300  300       0  1400     0>
            ;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios =
            <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 19
            <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 18
            <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 13
            <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 12
            <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 5
            <&gpio0  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 5
            <&gpio1  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 4
            <&gpio1  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // ex1
            <&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 20
            <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 17
            <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 14
            <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 14
            <&gpio0  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 11
            <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 6
            <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 3
            <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // ex2
            <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 21
            <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 16
            <&gpio0  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 2
            <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 7
            <&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 10
            <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 15
            <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,  // 15
            <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // 15
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
};

&reg0 {
    status = "okay";
};
&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };
        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };
        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
